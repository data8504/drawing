<?xml version='1.0' encoding='utf-8'?>
<interface domain="drawing">
  <requires lib="gtk" version="4.0" />
  <object class="GtkActionBar" id="bottom-pane">
    <property name="visible">0</property>
    <property name="hexpand">1</property>
    <property name="vexpand">1</property>
    <child>
      <object class="GtkButton" id="cancel_btn">
        <property name="tooltip_text" translatable="1">Cancel transformation</property>
        <property name="valign">center</property>
        <property name="action_name">win.cancel_transform</property>
        <style>
          <class name="destructive-action" />
        </style>
        <child>
          <object class="GtkImage">
            <property name="icon-name">go-previous-symbolic</property>
          </object>
        </child>
      </object>
    </child>
    <child type="end">
      <object class="GtkButton" id="apply_btn">
        <property name="action_name">win.apply_transform</property>
        <property name="tooltip-text" translatable="1">Apply transformation</property>
        <property name="valign">center</property>
        <style>
          <class name="suggested-action" />
        </style>
        <child>
          <object class="GtkImage">
            <property name="icon-name">emblem-ok-symbolic</property>
          </object>
        </child>
      </object>
    </child>
    <child type="end">
      <object class="GtkMenuButton" id="options_btn">
        <property name="tooltip-text" translatable="1">More options</property>
        <property name="valign">center</property>
        <property name="halign">center</property>
        <child>
          <object class="GtkImage">
            <property name="icon-name">view-more-symbolic</property>
          </object>
        </child>
      </object>
    </child>
    <child type="end">
      <object class="GtkButton" id="help_btn">
        <property name="has-frame">false</property>
        <property name="tooltip-text" translatable="1">Help about transformation tools</property>
        <property name="action-name">app.help_transform</property>
        <child>
          <object class="GtkImage">
            <property name="icon-name">help-faq-symbolic</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
