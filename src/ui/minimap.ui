<?xml version='1.0' encoding='utf-8'?>
<interface domain="drawing">
  <requires lib="gtk" version="4.0" />
  <object class="GtkAdjustment" id="zoom_adj">
    <property name="lower">20</property>
    <property name="upper">400</property>
    <property name="step_increment">20</property>
    <property name="page_increment">100</property>
    <property name="value">100</property>
  </object>
  <object class="GtkBox" id="minimap_box">
    <property name="orientation">vertical</property>
    <property name="spacing">6</property>
    <property name="margin-start">6</property>
    <property name="margin-end">6</property>
    <property name="margin-top">6</property>
    <property name="margin-bottom">6</property>
    <child>
      <object class="GtkFrame">
        <property name="child">
          <object class="GtkDrawingArea" id="_minimap_area">
            <property name="focusable">1</property>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkCenterBox">
        <property name="hexpand">1</property>
        <property name="vexpand">1</property>
        <property name="start-widget">
          <object class="GtkBox">
            <child>
              <object class="GtkButton">
                <property name="action-name">win.zoom_opti</property>
                <property name="tooltip-text" translatable="1">Optimal Zoom</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">zoom-fit-best-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="action-name">app.help_zoom</property>
                <property name="tooltip-text" translatable="1">Help about zooming</property>
                <property name="has-frame">false</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">help-faq-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
        <property name="end-widget">
          <object class="GtkBox">
            <child>
              <object class="GtkBox">
                <style>
                  <class name="linked" />
                </style>
                <child>
                  <object class="GtkButton">
                    <property name="action-name">win.zoom_out</property>
                    <property name="tooltip-text" translatable="1">Zoom Out</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">zoom-out-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton">
                    <property name="action-name">win.zoom_100</property>
                    <property name="label" translatable="1">100%</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton">
                    <property name="action-name">win.zoom_in</property>
                    <property name="tooltip-text" translatable="1">Zoom In</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">zoom-in-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="hexpand">1</property>
        <property name="vexpand">1</property>
        <child>
          <object class="GtkScale" id="_zoom_scale">
            <property name="draw-value">1</property>
            <property name="hexpand">1</property>
            <property name="vexpand">1</property>
            <property name="digits">0</property>
            <property name="adjustment">zoom_adj</property>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="valign">center</property>
            <property name="action-name">win.zoom_max</property>
            <property name="tooltip-text" translatable="1">Maximum zoom</property>
            <property name="has-frame">false</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">go-last-symbolic</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
