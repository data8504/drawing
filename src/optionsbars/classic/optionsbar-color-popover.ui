<?xml version='1.0' encoding='utf-8'?>
<interface domain="drawing">
  <requires lib="gtk" version="4.0" />
  <object class="GtkBox" id="main-box">
    <property name="margin-start">10</property>
    <property name="margin-end">10</property>
    <property name="margin-top">10</property>
    <property name="margin-bottom">10</property>
    <property name="spacing">10</property>
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkCenterBox">
        <property name="start-widget">
          <object class="GtkBox">
            <child>
              <object class="GtkLabel" id="popover-title">
                <property name="label">set by python code</property>
                <style>
                  <class name="dim-label" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="operator-box-start">
                <property name="spacing">6</property>
                <property name="tooltip-text" translatable="1">How the color will be applied to the existing pixels</property>
                <child>
                  <object class="GtkToggleButton" id="op-group">
                    <property name="label" translatable="1">Normal</property>
                    <property name="action-name">win.cairo_op_mirror</property>
                    <property name="action-target">'over'</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="operator-box-end">
                <property name="group">op-group</property>
                <property name="tooltip-text" translatable="1">Erase</property>
                <property name="action-name">win.cairo_op_mirror</property>
                <property name="action-target">'clear'</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">tool-eraser-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
        <property name="end-widget">
          <object class="GtkBox">
            <child>
              <object class="GtkButton">
                <property name="tooltip-text" translatable="1">Help about colors</property>
                <property name="action-name">app.help_colors</property>
                <property name="has-frame">false</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">help-faq-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkColorChooserWidget" id="color-widget" />
    </child>
    <child>
      <object class="GtkBox" id="editor-box">
        <property name="spacing">10</property>
        <child>
          <object class="GtkButton" id="back-btn">
            <property name="tooltip-text" translatable="1">Back to the palette</property>
            <child>
              <object class="GtkBox">
                <property name="spacing">10</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">go-previous-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="1">Palette</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
