<?xml version='1.0' encoding='utf-8'?>
<interface domain="drawing">
  <requires lib="gtk" version="4.0" />
  <object class="GtkBox" id="centered_box">
    <property name="spacing">10</property>
    <child>
      <object class="GtkMenuButton" id="menu_btn">
        <child>
          <object class="GtkBox">
            <property name="spacing">2</property>
            <child>
              <object class="GtkLabel" id="menu_label">
                <property name="label" translatable="1">Select a filter…</property>
              </object>
            </child>
            <child>
              <object class="GtkImage" id="menu_icon">
                <property name="icon-name">view-more-symbolic</property>
              </object>
            </child>
            <child>
              <object class="GtkImage">
                <property name="icon-name">pan-down-symbolic</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
