<?xml version='1.0' encoding='utf-8'?>
<interface domain="drawing">
  <requires lib="gtk" version="4.0" />
  <object class="GtkHeaderBar" id="header_bar">
    <child>
      <object class="GtkMenuButton" id="new_btn">
        <property name="has-frame">false</property>
        <property name="valign">center</property>
        <property name="tooltip-text" translatable="1">New Image</property>
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkImage">
                <property name="icon-name">document-new</property>
                <property name="pixel-size">24</property>
              </object>
            </child>
            <child>
              <object class="GtkImage">
                <property name="icon-name">pan-down</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkButton">
        <property name="action-name">win.open</property>
        <property name="has-frame">false</property>
        <property name="valign">center</property>
        <property name="tooltip-text" translatable="1">Open</property>
        <child>
          <object class="GtkImage">
            <property name="icon-name">document-open</property>
            <property name="pixel-size">24</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="valign">center</property>
        <child>
          <object class="GtkButton" id="undo_btn">
            <property name="has-frame">false</property>
            <property name="action-name">win.undo</property>
            <property name="tooltip-text" translatable="1">Undo</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">edit-undo</property>
                <property name="pixel-size">24</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="redo_btn">
            <property name="has-frame">false</property>
            <property name="action-name">win.redo</property>
            <property name="tooltip-text" translatable="1">Redo</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">edit-redo</property>
                <property name="pixel-size">24</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child type="end">
      <object class="GtkMenuButton" id="main_menu_btn">
        <property name="valign">center</property>
        <property name="has-frame">false</property>
        <child>
          <object class="GtkImage">
            <property name="icon-name">open-menu</property>
            <property name="pixel-size">24</property>
          </object>
        </child>
      </object>
    </child>
    <child type="end">
      <object class="GtkMenuButton" id="hidable1">
        <property name="has-frame">false</property>
        <property name="valign">center</property>
        <property name="tooltip-text" translatable="1">Save as…</property>
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkImage">
                <property name="icon-name">document-save-as</property>
                <property name="pixel-size">24</property>
              </object>
            </child>
            <child>
              <object class="GtkImage">
                <property name="icon-name">pan-down</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child type="end">
      <object class="GtkButton" id="save_long">
        <property name="visible">0</property>
        <property name="valign">center</property>
        <property name="has-frame">false</property>
        <property name="action-name">win.save</property>
        <property name="tooltip-text" translatable="1">Save</property>
        <child>
          <object class="GtkImage">
            <property name="icon-name">document-save</property>
            <property name="pixel-size">24</property>
          </object>
        </child>
      </object>
    </child>
    <child type="end">
      <object class="GtkButton" id="save_short">
        <property name="valign">center</property>
        <property name="has-frame">false</property>
        <property name="action-name">win.save</property>
        <property name="tooltip-text" translatable="1">Save</property>
        <child>
          <object class="GtkImage">
            <property name="icon-name">document-save</property>
            <property name="pixel-size">24</property>
          </object>
        </child>
      </object>
    </child>
    <child type="end">
      <object class="GtkMenuButton" id="hidable2">
        <property name="has-frame">false</property>
        <property name="valign">center</property>
        <property name="tooltip-text" translatable="1">Share the image</property>
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkImage">
                <property name="icon-name">send-to</property>
                <property name="pixel-size">24</property>
              </object>
            </child>
            <child>
              <object class="GtkImage">
                <property name="icon-name">pan-down</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
