<?xml version='1.0' encoding='utf-8'?>
<interface domain="drawing">
  <requires lib="gtk" version="4.0" />
  <object class="GtkAdjustment" id="adjustment_size">
    <property name="lower">1</property>
    <property name="upper">200</property>
    <property name="step_increment">1</property>
    <property name="page_increment">10</property>
    <property name="value">10</property>
  </object>
  <template class="DrWindow" parent="GtkApplicationWindow">
    <property name="icon-name">com.github.maoschanz.drawing</property>
    <child>
      <object class="GtkBox" id="main_box">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="toolbar_box">
            <property name="orientation">vertical</property>
            <property name="visible">0</property>
            <style>
              <class name="primary-toolbar" />
            </style>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkSeparator">
                    </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkInfoBar" id="info_bar">
            <property name="show-close-button">1</property>
            <action-widgets>
              <action-widget response="ok">info_action</action-widget>
            </action-widgets>
            <child>
              <object class="GtkBox">
                <child>
                  <object class="GtkLabel" id="info_label">
                    <property name="wrap">1</property>
                    <property name="label" translatable="1">Loading…</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="action">
              <object class="GtkButton" id="info_action">
                <property name="action-name">app.report-issue</property>
                <property name="label" translatable="1">Report a bug</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="vexpand">1</property>
            <child>
              <object class="GtkScrolledWindow">
                <property name="vscrollbar-policy">external</property>
                <property name="hscrollbar-policy">never</property>
                <property name="child">
                  <object class="GtkBox" id="tools_scrollable_box">
                    <property name="hexpand">0</property>
                    <property name="vexpand">0</property>
                    <property name="halign">center</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="tools_nonscrollable_box">
                <child>
                  <object class="GtkFlowBox" id="tools_flowbox">
                    <property name="orientation">vertical</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkSeparator" />
            </child>
            <child>
              <object class="GtkNotebook" id="notebook">
                <property name="hexpand">1</property>
                <property name="show-tabs">0</property>
                <property name="scrollable">1</property>
                <property name="group-name">drawing-tabs</property>
                <child type="action-end">
                  <object class="GtkButton">
                    <property name="has-frame">false</property>
                    <property name="action-name">win.new_tab</property>
                    <property name="tooltip-text" translatable="1">New Image</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">tab-new-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="bottom_meta_box">
            <property name="hexpand">0</property>
            <property name="vexpand">0</property>
            <child>
              <object class="GtkBox" id="bottom_panes_box">
                <property name="orientation">vertical</property>
                <property name="hexpand">1</property>
                <property name="vexpand">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="unfullscreen_btn">
                <property name="visible">0</property>
                <property name="valign">center</property>
                <property name="margin-end">6</property>
                <property name="tooltip-text" translatable="1">Exit fullscreen</property>
                <property name="action-name">win.unfullscreen</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">view-restore-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
